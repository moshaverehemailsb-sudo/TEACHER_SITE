DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
ADMIN_TOKEN=
SECRET_KEY=
PHONE_HASH_KEY=
# development یا production. در سرور واقعی production بگذار.
APP_ENV=production
# console فقط وقتی کار می‌کند که APP_ENV=development باشد. در سرور واقعی خالی بماند.
SMS_PROVIDER=
# پشت پروکسی معکوس (مثل nginx): آدرس IP پروکسی، تا محدودیت تعداد درخواست IP واقعی را ببیند
FORWARDED_ALLOW_IPS=127.0.0.1