DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
ADMIN_TOKEN=
SECRET_KEY=
PHONE_HASH_KEY=
# development یا production. در سرور واقعی production بگذار.
APP_ENV=production
# console فقط وقتی کار می‌کند که APP_ENV=development باشد. در سرور واقعی اسم سرویس پیامک.
SMS_PROVIDER=
# حداکثر تعداد کد تأیید در ۲۴ ساعت برای کل سایت (سقف هزینه‌ی پیامک)
SMS_DAILY_LIMIT=500
# مسیر پوشه‌ی فرانت؛ اگر پر باشد بک‌اند خودش فرانت را هم می‌دهد
FRONTEND_DIR=
# پشت پروکسی معکوس (مثل nginx): آدرس IP پروکسی
FORWARDED_ALLOW_IPS=127.0.0.1
TEST_DATABASE_URL=
SMS_API_KEY=
SMS_SENDER=